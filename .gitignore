coverage/

# 验证产物（保留特定证据用 git add -f）
data/verify/

# 测试上传的产品图残留
data/oss/[0-9a-f]/

# SQLite 数据库（运行时生成，含历史记录，不提交）
*.sqlite
*.sqlite-wal
*.sqlite-shm

# 数据库本地备份（手动/自动生成，不提交）
data/backup/
packages/*/data/backup/

# Windows reserved name artifact
nul

# 外部参考仓库（独立 git 仓库，不纳入本仓库）
/detail-flow/

# 运行时 OSS 素材与临时图片（生成产物，不提交）
# oss/ 下除内置素材 materials/builtin-mat-* 外全部忽略（含运行时生成的 UUID 媒体目录）
packages/*/data/oss/*
!packages/*/data/oss/materials/
packages/*/data/oss/materials/*
!packages/*/data/oss/materials/builtin-mat-*.png

# 根目录临时测试脚本与产物（一次性验证用）
/test-*.js
/test-*.png
/test-screenshots/
/generated-materials.json

# 路演/参赛演示材料与一次性生成脚本（仅本地保留，不进入仓库）
