# 火山引擎（即梦 seedream + 视频）
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=

# 阿里云 DashScope（OutfitAnyone / Qwen-VL）
DASHSCOPE_API_KEY=

# OpenAI（gpt-image-1，可选，海外场景）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 主推理 LLM（多模态）— 用 OpenAI 兼容端点
ORCHESTRATOR_BASE_URL=
ORCHESTRATOR_API_KEY=
ORCHESTRATOR_MODEL=

# Agnes AI（图片生成 + 视频生成）
AGNES_API_KEY=

# 腾讯云 COS（图生视频/试穿需公网图片URL，未配置则降级）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_APP_ID=
COS_BUCKET=
COS_REGION=ap-shanghai
COS_PUBLIC_BASE=

# 凭证加密主密钥（32 字节 hex，生产环境必须设置，用 `openssl rand -hex 32` 生成）
MASTER_KEY=

# 运行环境（生产必须设为 production，否则凭证用弱密钥）
NODE_ENV=production

# 服务端口
PORT=4096
