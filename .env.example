# 火山引擎（即梦 seedream + 视频）
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=

# 阿里云 DashScope（OutfitAnyone / Qwen-VL）
DASHSCOPE_API_KEY=

# OpenAI（gpt-image-1，可选，海外场景）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 主推理 LLM（多模态）— 用 OpenAI 兼容端点
ORCHESTRATOR_BASE_URL=
ORCHESTRATOR_API_KEY=
ORCHESTRATOR_MODEL=

# Agnes AI（图片生成 + 视频生成）
AGNES_API_KEY=

# 凭证加密主密钥（32 字节 hex，可用 `openssl rand -hex 32` 生成）
MASTER_KEY=

# 服务端口
PORT=4096
